{
  "functions": {
    "api/tmdb.js": {
      "runtime": "edge"
    },
    "api/feedback.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 10
    },
    "api/send-verification.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",          "value": "DENY" },
        { "key": "Referrer-Policy",          "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
